<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<meta name="theme-color" content="#f6f7f4">
	<title>Quizletto — Find your next little obsession</title>
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
	<style>
		:root {
			color-scheme: light;
			--ink: #172019;
			--muted: #748078;
			--paper: #f6f7f4;
			--white: #fff;
			--line: #e6e9e3;
			--green: #245c43;
			--lime: #d7ed71;
			--orange: #f18b59;
			--shadow: 0 16px 38px rgba(27, 44, 32, .09);
			font-family: "DM Sans", sans-serif;
			font-synthesis: none;
			text-rendering: optimizeLegibility;
			-webkit-font-smoothing: antialiased;
		}

		* { box-sizing: border-box; }
		body { margin: 0; min-width: 320px; background: var(--paper); color: var(--ink); }
		button, input { font: inherit; }
		button { color: inherit; }
		button:focus-visible, input:focus-visible { outline: 3px solid #9bbd48; outline-offset: 3px; }
		.shell { max-width: 1440px; min-height: 100vh; margin: auto; padding: 0 54px 60px; }
		.topbar { height: 82px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--line); }
		.brand { display: inline-flex; gap: 10px; align-items: center; color: var(--ink); text-decoration: none; font: 700 22px "Space Grotesk", sans-serif; letter-spacing: -.8px; }
		.brand-mark { display: grid; width: 30px; height: 30px; place-items: center; border-radius: 9px; background: var(--green); color: var(--lime); font-size: 19px; }
		.nav { display: flex; align-items: center; gap: 30px; color: #647068; font-size: 13px; }
		.nav a { color: inherit; text-decoration: none; }
		.nav a:hover { color: var(--green); }
		.nav .nav-active { color: var(--ink); font-weight: 700; }
		.profile { display: flex; align-items: center; gap: 9px; font-size: 13px; font-weight: 600; }
		.avatar { display: grid; width: 34px; height: 34px; place-items: center; border-radius: 50%; background: #e5dfc8; font-size: 17px; }
		.intro { padding: 46px 0 28px; display: flex; justify-content: space-between; align-items: end; gap: 20px; }
		.eyebrow { margin: 0 0 10px; color: var(--green); font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.7px; }
		h1, h2, h3, p { margin-top: 0; }
		h1 { margin-bottom: 8px; font: 600 clamp(30px, 4vw, 42px)/1.1 "Space Grotesk", sans-serif; letter-spacing: -1.7px; }
		.intro-copy { margin-bottom: 0; color: var(--muted); font-size: 14px; }
		.streak { display: flex; align-items: center; gap: 10px; padding: 12px 15px; border: 1px solid var(--line); border-radius: 8px; background: var(--white); font-size: 12px; }
		.streak-icon { font-size: 20px; }
		.streak strong { display: block; font-size: 13px; }
		.streak span:last-child { color: var(--muted); }
		.feature { position: relative; display: grid; grid-template-columns: 1fr 42%; min-height: 236px; overflow: hidden; border-radius: 9px; background: #d9e8d4; }
		.feature-copy { display: flex; flex-direction: column; align-items: flex-start; justify-content: center; padding: 32px 38px; }
		.feature-label { margin-bottom: 12px; color: #315a3e; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.4px; }
		.feature h2 { max-width: 460px; margin-bottom: 9px; font: 600 27px/1.14 "Space Grotesk", sans-serif; letter-spacing: -.8px; }
		.feature p { margin-bottom: 17px; color: #536658; font-size: 13px; }
		.feature-photo { min-height: 236px; background: linear-gradient(90deg, #d9e8d4 0%, transparent 30%), url("https://images.unsplash.com/photo-1526778548025-fa2f459cd5c1?auto=format&fit=crop&w=1100&q=85") center 48% / cover; }
		.button { display: inline-flex; justify-content: center; align-items: center; gap: 8px; min-height: 40px; padding: 0 16px; border: 0; border-radius: 6px; background: var(--green); color: #fff; cursor: pointer; font-size: 12px; font-weight: 700; transition: background .16s, transform .16s; }
		.button:hover { background: #194833; transform: translateY(-1px); }
		.button.secondary { border: 1px solid var(--line); background: white; color: var(--ink); }
		.button.secondary:hover { background: #f1f5ee; }
		.catalog { display: grid; grid-template-columns: 210px minmax(0, 1fr); gap: 36px; margin-top: 37px; }
		.sidebar { padding-top: 2px; }
		.side-heading { margin: 0 0 11px; color: #889189; font-size: 10px; font-weight: 700; letter-spacing: 1.3px; text-transform: uppercase; }
		.category-list { display: grid; gap: 4px; margin-bottom: 28px; }
		.category-button { display: flex; width: 100%; align-items: center; justify-content: space-between; padding: 10px 11px; border: 0; border-radius: 6px; background: transparent; color: #626c64; cursor: pointer; text-align: left; font-size: 12px; }
		.category-button:hover { background: #ecefe9; }
		.category-button.active { background: #e5ede3; color: var(--green); font-weight: 700; }
		.category-count { color: #929b93; font-size: 10px; }
		.sidebar-note { padding: 16px; border-radius: 7px; background: #f0eadd; }
		.sidebar-note strong { display: block; margin-bottom: 5px; font: 600 14px "Space Grotesk", sans-serif; }
		.sidebar-note p { margin-bottom: 12px; color: #746f60; font-size: 11px; line-height: 1.5; }
		.text-button { padding: 0; border: 0; background: transparent; color: var(--green); cursor: pointer; font-size: 11px; font-weight: 700; }
		.catalog-main { min-width: 0; }
		.catalog-heading { display: flex; align-items: center; justify-content: space-between; gap: 14px; margin-bottom: 16px; }
		.catalog-heading h2 { margin: 0; font: 600 21px "Space Grotesk", sans-serif; letter-spacing: -.5px; }
		.results-count { margin-left: 7px; color: #8a938c; font: 500 11px "DM Sans", sans-serif; letter-spacing: 0; }
		.search-wrap { position: relative; width: min(100%, 290px); }
		.search-wrap svg { position: absolute; top: 50%; left: 12px; width: 16px; height: 16px; transform: translateY(-50%); color: #87918a; pointer-events: none; }
		.search-input { width: 100%; height: 39px; padding: 0 12px 0 36px; border: 1px solid #e1e5de; border-radius: 6px; background: #fff; color: var(--ink); font-size: 12px; }
		.search-input::placeholder { color: #9aa29b; }
		.toolbar { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 16px; }
		.chips { display: flex; gap: 7px; overflow-x: auto; scrollbar-width: none; }
		.chips::-webkit-scrollbar { display: none; }
		.chip { flex: 0 0 auto; padding: 7px 11px; border: 1px solid #e2e6df; border-radius: 5px; background: transparent; color: #68736a; cursor: pointer; font-size: 10px; }
		.chip:hover, .chip.active { border-color: var(--green); background: var(--green); color: white; }
		.sort-select { height: 31px; padding: 0 25px 0 8px; border: 0; background: transparent; color: #727d74; font-size: 11px; cursor: pointer; }
		.quiz-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 15px; }
		.load-more-wrap { margin-top: 18px; text-align: center; }
		.load-more { min-width: 170px; }
		.quiz-card { min-width: 0; overflow: hidden; border: 1px solid #e7eae4; border-radius: 7px; background: white; transition: transform .18s, box-shadow .18s; }
		.quiz-card:hover { transform: translateY(-3px); box-shadow: var(--shadow); }
		.card-image { position: relative; height: 128px; background-color: #e6e9df; background-position: center; background-size: cover; }
		.card-category { position: absolute; top: 10px; left: 10px; padding: 5px 8px; border-radius: 4px; background: rgba(255,255,255,.92); color: #45554a; font-size: 9px; font-weight: 700; }
		.bookmark { position: absolute; top: 8px; right: 8px; display: grid; width: 29px; height: 29px; place-items: center; border: 0; border-radius: 50%; background: rgba(255,255,255,.94); cursor: pointer; color: #657269; }
		.bookmark.saved { color: #d46d4a; }
		.bookmark svg { width: 15px; height: 15px; }
		.card-body { padding: 13px 13px 12px; }
		.card-body h3 { margin-bottom: 5px; font: 600 15px/1.25 "Space Grotesk", sans-serif; letter-spacing: -.2px; }
		.card-description { min-height: 33px; margin-bottom: 11px; color: #828b83; font-size: 10px; line-height: 1.5; }
		.card-footer { display: flex; align-items: center; justify-content: space-between; padding-top: 10px; border-top: 1px solid #eff1ed; color: #7d877f; font-size: 10px; }
		.card-meta { display: flex; align-items: center; gap: 9px; }
		.difficulty { color: #4a7455; }
		.play-link { padding: 4px 0 4px 6px; border: 0; background: none; color: var(--green); cursor: pointer; font-size: 10px; font-weight: 700; }
		.empty-state { grid-column: 1 / -1; padding: 60px 20px; color: var(--muted); text-align: center; }
		.empty-state strong { display: block; margin-bottom: 6px; color: var(--ink); font: 600 18px "Space Grotesk", sans-serif; }
		.history-page { padding: 46px 0 20px; }
		.history-heading { margin-bottom: 26px; }
		.history-list { display: grid; gap: 12px; }
		.history-card { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 18px 20px; border: 1px solid var(--line); border-radius: 8px; background: var(--white); }
		.history-info { min-width: 0; }
		.history-date { display: block; margin-bottom: 6px; color: #89928a; font-size: 10px; }
		.history-info h2 { margin: 0 0 5px; font: 600 17px "Space Grotesk", sans-serif; }
		.history-info p { margin: 0; color: var(--muted); font-size: 11px; }
		.history-result { display: flex; align-items: center; gap: 19px; flex: 0 0 auto; }
		.history-score { text-align: right; }
		.history-score strong { display: block; color: var(--green); font: 600 21px "Space Grotesk", sans-serif; }
		.history-score span { color: var(--muted); font-size: 10px; }
		.history-notice { margin: 0 0 16px; padding: 12px 14px; border-radius: 6px; background: #fff1ec; color: #984b36; font-size: 12px; }
		.modal-backdrop { position: fixed; z-index: 5; inset: 0; display: grid; place-items: center; padding: 20px; background: rgba(19, 30, 22, .52); backdrop-filter: blur(4px); }
		.modal { width: min(100%, 540px); max-height: min(720px, 92vh); overflow: auto; padding: 25px; border-radius: 9px; background: var(--white); box-shadow: 0 28px 80px rgba(0, 0, 0, .2); animation: arrive .2s ease-out; }
		@keyframes arrive { from { opacity: 0; transform: translateY(8px) scale(.99); } to { opacity: 1; transform: translateY(0) scale(1); } }
		.modal-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 14px; }
		.modal-top h2 { margin: 0 0 5px; font: 600 22px "Space Grotesk", sans-serif; }
		.modal-top p { margin-bottom: 0; color: var(--muted); font-size: 12px; }
		.close-button { display: grid; width: 34px; height: 34px; flex: 0 0 auto; place-items: center; border: 0; border-radius: 5px; background: #f1f3ef; cursor: pointer; font-size: 19px; }
		.progress-row { display: flex; justify-content: space-between; margin: 25px 0 9px; color: #78827a; font-size: 11px; }
		.progress-track { height: 5px; overflow: hidden; border-radius: 5px; background: #edf0ea; }
		.progress-fill { height: 100%; border-radius: inherit; background: #6f9c59; transition: width .2s; }
		.question { margin: 24px 0 16px; font: 600 20px/1.35 "Space Grotesk", sans-serif; }
		.answers { display: grid; gap: 9px; }
		.answer { width: 100%; padding: 12px 14px; border: 1px solid #e4e8e1; border-radius: 6px; background: white; cursor: pointer; text-align: left; font-size: 13px; transition: border .14s, background .14s; }
		.answer:hover:not(:disabled) { border-color: #88a67c; background: #f7faf4; }
		.answer.correct { border-color: #79a36b; background: #eff7eb; color: #315e36; }
		.answer.incorrect { border-color: #df8b72; background: #fff1ec; color: #984b36; }
		.answer:disabled { cursor: default; }
		.feedback { min-height: 20px; margin: 13px 0 3px; color: #64736a; font-size: 12px; }
		.modal-actions { display: flex; justify-content: space-between; align-items: center; margin-top: 14px; }
		.score-panel { padding: 28px 10px 14px; text-align: center; }
		.score-number { display: block; margin-bottom: 4px; color: var(--green); font: 600 48px "Space Grotesk", sans-serif; }
		.score-panel h3 { margin-bottom: 6px; font: 600 21px "Space Grotesk", sans-serif; }
		.score-panel p { margin-bottom: 22px; color: var(--muted); font-size: 13px; }
		[hidden] { display: none !important; }
		@media (max-width: 1000px) {
			.shell { padding-right: 32px; padding-left: 32px; }
			.quiz-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
			.catalog { grid-template-columns: 180px minmax(0, 1fr); gap: 24px; }
			.card-image { height: 145px; }
		}
		@media (max-width: 680px) {
			.shell { padding: 0 19px 36px; }
			.topbar { height: 66px; }
			.nav { gap: 10px; font-size: 11px; }
			.profile > span:last-child { display: none; }
			.intro { padding: 32px 0 21px; }
			.intro-copy { max-width: 270px; line-height: 1.5; }
			.streak { padding: 9px; }
			.streak span:last-child { display: none; }
			.feature { grid-template-columns: 1fr; }
			.feature-copy { padding: 27px 23px; }
			.feature-photo { position: absolute; inset: 0 0 0 48%; min-height: 100%; opacity: .35; }
			.feature-copy { position: relative; z-index: 1; }
			.feature h2 { max-width: 310px; font-size: 24px; }
			.catalog { grid-template-columns: 1fr; gap: 16px; margin-top: 27px; }
			.sidebar { display: contents; }
			.sidebar > .side-heading, .sidebar-note { display: none; }
			.category-list { display: flex; gap: 5px; overflow-x: auto; order: 0; margin: 0; scrollbar-width: none; }
			.category-button { width: auto; flex: 0 0 auto; padding: 8px 10px; border: 1px solid #e2e6df; font-size: 11px; }
			.category-count { display: none; }
			.catalog-main { display: contents; }
			.catalog-heading { grid-column: 1; margin: 2px 0 0; }
			.toolbar { grid-column: 1; margin-bottom: 0; }
			.search-wrap { width: 100%; }
			.chips { max-width: calc(100vw - 120px); }
			.quiz-grid { grid-column: 1; }
			.history-page { padding-top: 32px; }
			.history-card { align-items: flex-start; padding: 15px; }
			.history-result { gap: 12px; }
			.history-result .button { min-height: 36px; padding: 0 10px; }
		}
		@media (max-width: 430px) {
			.shell { padding-right: 14px; padding-left: 14px; }
			.brand { gap: 7px; font-size: 20px; }
			.nav { gap: 8px; font-size: 10px; }
			.avatar { width: 30px; height: 30px; }
			.intro { align-items: flex-start; }
			.intro-copy { max-width: 230px; font-size: 12px; }
			.streak { gap: 5px; }
			.streak strong { font-size: 11px; }
			.quiz-grid { grid-template-columns: 1fr; gap: 11px; }
			.quiz-card { display: grid; grid-template-columns: 116px 1fr; min-height: 126px; }
			.card-image { height: 100%; min-height: 126px; }
			.card-body { display: flex; flex-direction: column; justify-content: center; padding: 10px; }
			.card-description { min-height: auto; margin-bottom: 8px; }
			.card-footer { padding-top: 7px; }
			.card-meta { gap: 6px; }
			.feature-copy { padding: 23px 18px; }
			.history-card { flex-direction: column; gap: 13px; }
			.history-result { width: 100%; justify-content: space-between; }
			.history-score { text-align: left; }
		}
		@media (prefers-reduced-motion: reduce) { *, *::before, *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; transition-duration: .01ms !important; } }
	</style>
</head>
<body>
	<div class="shell">
		<header class="topbar">
			<a class="brand" href="#" aria-label="Quizletto home"><span class="brand-mark">?</span>quizletto</a>
			<nav class="nav" aria-label="Main navigation">
				<a class="nav-active" href="#discover" id="discoverLink" aria-current="page">Discover</a>
				<a href="#saved" id="savedLink">Saved</a>
				<a href="#history" id="historyLink">History</a>
			</nav>
			<div class="profile"><span class="avatar" aria-hidden="true">🌱</span><span>Curious mind</span></div>
		</header>

		<main id="discover">
			<section class="intro" aria-labelledby="pageTitle">
				<div>
					<p class="eyebrow">A little curiosity goes a long way</p>
					<h1 id="pageTitle">Find your next little obsession.</h1>
					<p class="intro-copy">Pick a quiz, learn a surprising thing, and see what sticks.</p>
				</div>
				<div class="streak"><span class="streak-icon" aria-hidden="true">✳</span><div><strong>Good day to learn</strong><span>One quiz is a lovely start</span></div></div>
			</section>

			<section class="feature" id="feature" aria-label="Featured quiz">
				<div class="feature-copy">
					<span class="feature-label">This week's curious pick</span>
					<h2>Could you find your way around the world?</h2>
					  <p>Take the scenic route through 3 geography questions.</p>
					<button class="button" type="button" data-quiz="world-geography">Take the quiz <span aria-hidden="true">→</span></button>
				</div>
				<div class="feature-photo" role="img" aria-label="A world map carved into wood"></div>
			</section>

			<section class="catalog" aria-label="Quiz catalog">
				<aside class="sidebar" aria-label="Quiz categories">
					<p class="side-heading">Browse by topic</p>
					<div class="category-list" id="categoryList"></div>
					<div class="sidebar-note"><strong>Something on your mind?</strong><p>Search a topic and see where your curiosity takes you.</p><button class="text-button" type="button" id="surpriseButton">Surprise me <span aria-hidden="true">↗</span></button></div>
				</aside>
				<div class="catalog-main">
					<div class="catalog-heading">
						<h2 id="catalogTitle">Explore quizzes <span class="results-count" id="resultsCount"></span></h2>
						<label class="search-wrap">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"></circle><path d="m16 16 4.5 4.5"></path></svg>
							<input class="search-input" id="searchInput" type="search" placeholder="Search topics, quizzes..." autocomplete="off" aria-label="Search quizzes">
						</label>
					</div>
					<div class="toolbar">
						<div class="chips" id="difficultyChips" aria-label="Filter by difficulty">
							<button class="chip active" type="button" data-difficulty="All levels">All levels</button>
							<button class="chip" type="button" data-difficulty="Easy">Easy</button>
							<button class="chip" type="button" data-difficulty="Medium">Medium</button>
							<button class="chip" type="button" data-difficulty="Tricky">Tricky</button>
						</div>
						<select class="sort-select" id="sortSelect" aria-label="Sort quizzes">
							<option value="popular">Most popular</option>
							<option value="az">A to Z</option>
							<option value="short">Quickest first</option>
						</select>
					</div>
					<div class="quiz-grid" id="quizGrid" aria-live="polite"></div>
					<div class="load-more-wrap" id="loadMoreWrap" hidden>
						<button class="button secondary load-more" id="loadMoreButton" type="button">Load more quizzes</button>
					</div>
				</div>
			</section>
		</main>
		<section class="history-page" id="historyPage" aria-labelledby="historyTitle" hidden>
			<div class="history-heading">
				<p class="eyebrow">Your curious little milestones</p>
				<h1 id="historyTitle">Quiz history.</h1>
				<p class="intro-copy">Every quiz you finish, along with the score you earned.</p>
			</div>
			<p class="history-notice" id="historyNotice" role="status" hidden></p>
			<div class="history-list" id="historyList" aria-live="polite"></div>
		</section>
	</div>

	<div class="modal-backdrop" id="quizModal" hidden>
		<section class="modal" role="dialog" aria-modal="true" aria-labelledby="quizTitle">
			<div class="modal-top"><div><h2 id="quizTitle"></h2><p id="quizSubtitle"></p></div><button class="close-button" id="closeModal" type="button" aria-label="Close quiz">×</button></div>
			<div id="questionView">
				<div class="progress-row"><span id="progressText"></span><span id="scoreText">0 correct</span></div>
				<div class="progress-track"><div class="progress-fill" id="progressFill"></div></div>
				<h3 class="question" id="questionText"></h3>
				<div class="answers" id="answerList"></div>
				<p class="feedback" id="feedback" aria-live="polite"></p>
				<div class="modal-actions"><span></span><button class="button" id="nextQuestion" type="button" hidden>Next question <span aria-hidden="true">→</span></button></div>
			</div>
			<div class="score-panel" id="scoreView" hidden><span class="score-number" id="finalScore"></span><h3 id="scoreHeading"></h3><p id="scoreMessage"></p><button class="button" id="finishQuiz" type="button">Back to exploring</button></div>
		</section>
	</div>

	<script>
		const quizzes = [
			{ id: "world-geography", title: "Around the world", category: "Geography", difficulty: "Easy", questions: 3, minutes: 2, plays: 942, description: "Test your map sense with island cities, vast deserts, and lake-rich countries.", image: "photo-1526778548025-fa2f459cd5c1", imagePosition: "center 53%", quiz: [
				{ q: "Which city is famously built across 14 islands?", a: ["Copenhagen", "Stockholm", "Helsinki", "Oslo"], correct: 1 },
				{ q: "What is the world's largest hot desert?", a: ["The Gobi", "The Sahara", "The Arabian Desert", "The Kalahari"], correct: 1 },
				{ q: "Which country has the most natural lakes?", a: ["Finland", "Canada", "Brazil", "Russia"], correct: 1 }

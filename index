			document.getElementById("catalogTitle").firstChild.textContent = state.savedOnly ? "Your saved quizzes " : "Explore quizzes ";
			const loadMoreWrap = document.getElementById("loadMoreWrap");
			loadMoreWrap.hidden = !(results.length > visibleResults.length);
			quizGrid.innerHTML = visibleResults.length ? visibleResults.map((quiz) => `
				<article class="quiz-card">
					<div class="card-image" role="img" aria-label="${quiz.category} quiz cover" style="background-image:url('https://images.unsplash.com/${quiz.image}?auto=format&fit=crop&w=700&q=80');background-position:${quiz.imagePosition}">
						<span class="card-category">${quiz.category}</span>
						<button class="bookmark${savedIds.has(quiz.id) ? " saved" : ""}" type="button" data-save="${quiz.id}" aria-label="${savedIds.has(quiz.id) ? "Remove from" : "Save to"} saved quizzes" aria-pressed="${savedIds.has(quiz.id)}">
							<svg viewBox="0 0 24 24" fill="${savedIds.has(quiz.id) ? "currentColor" : "none"}" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M6 4.8A1.8 1.8 0 0 1 7.8 3h8.4A1.8 1.8 0 0 1 18 4.8V21l-6-4-6 4V4.8Z"/></svg>
						</button>
					</div>
					<div class="card-body">
						<h3>${quiz.title}</h3>
						<p class="card-description">${quiz.description}</p>
						<div class="card-footer"><span class="card-meta"><span>${quiz.questions} questions</span><span>${quiz.minutes} min</span><span class="difficulty">${quiz.difficulty}</span></span><button class="play-link" type="button" data-quiz="${quiz.id}">Play <span aria-hidden="true">→</span></button></div>
					</div>
				</article>`).join("") : `<div class="empty-state"><strong>No quizzes found</strong>Try another search or clear a filter to keep exploring.</div>`;
			if (!visibleResults.length && results.length) {
				state.visibleCount = initialVisibleCount;
			}
		}

		function render() { renderCategories(); renderQuizzes(); }

		function renderHistory() {
			const notice = document.getElementById("historyNotice");
			notice.textContent = historyStorageError;
			notice.hidden = !historyStorageError;
			const historyList = document.getElementById("historyList");
			const orderedHistory = [...quizHistory].sort((first, second) => Date.parse(second.completedAt) - Date.parse(first.completedAt));
			if (!orderedHistory.length) {
				historyList.innerHTML = `<div class="empty-state"><strong>No completed quizzes yet</strong>Finish a quiz and your score will show up here.</div>`;
				return;
			}
			const percentages = orderedHistory.map((result) => Math.round(result.score / result.total * 100));
			const average = Math.round(percentages.reduce((sum, percentage) => sum + percentage, 0) / percentages.length);
			historyList.innerHTML = `<p class="intro-copy">${orderedHistory.length} ${orderedHistory.length === 1 ? "quiz" : "quizzes"} completed · ${average}% average score</p>` + orderedHistory.map((result) => {
				const quiz = quizzes.find((item) => item.id === result.quizId);
				const percentage = Math.round(result.score / result.total * 100);
				const completed = new Date(result.completedAt).toLocaleString(undefined, { dateStyle: "medium", timeStyle: "short" });
				return `<article class="history-card">
					<div class="history-info"><span class="history-date">${completed}</span><h2>${quiz.title}</h2><p>${quiz.category} · ${quiz.difficulty} · ${result.total} questions</p></div>
					<div class="history-result"><div class="history-score"><strong>${result.score}/${result.total}</strong><span>${percentage}% correct</span></div><button class="button secondary" type="button" data-replay="${quiz.id}">Play again <span aria-hidden="true">→</span></button></div>
				</article>`;
			}).join("");
		}

		function showView(view) {
			const isHistory = view === "history";
			document.getElementById("discover").hidden = isHistory;
			document.getElementById("historyPage").hidden = !isHistory;
			document.querySelectorAll(".nav a").forEach((link) => {
				const active = link.id === "historyLink" ? isHistory :
					link.id === "savedLink" ? !isHistory && state.savedOnly :
					!isHistory && !state.savedOnly;
				link.classList.toggle("nav-active", active);
				if (active) link.setAttribute("aria-current", "page");
				else link.removeAttribute("aria-current");
			});
		}

		function openQuiz(id) {
			activeQuiz = quizzes.find((quiz) => quiz.id === id);
			if (!activeQuiz) return;
			questionIndex = 0;
			score = 0;
			document.getElementById("quizTitle").textContent = activeQuiz.title;
			document.getElementById("quizSubtitle").textContent = `${activeQuiz.category} · ${activeQuiz.difficulty}`;
			document.getElementById("questionView").hidden = false;
			document.getElementById("scoreView").hidden = true;
			modal.hidden = false;
			document.body.style.overflow = "hidden";
			renderQuestion();
			document.getElementById("closeModal").focus();
		}

		function renderQuestion() {
			const question = activeQuiz.quiz[questionIndex];
			answered = false;
			document.getElementById("progressText").textContent = `Question ${questionIndex + 1} of ${activeQuiz.quiz.length}`;
			document.getElementById("scoreText").textContent = `${score} correct`;
			document.getElementById("progressFill").style.width = `${(questionIndex / activeQuiz.quiz.length) * 100}%`;
			document.getElementById("questionText").textContent = question.q;
			document.getElementById("feedback").textContent = "";
			document.getElementById("nextQuestion").hidden = true;
			document.getElementById("answerList").innerHTML = question.a.map((answer, index) => `<button class="answer" type="button" data-answer="${index}">${answer}</button>`).join("");
		}

		function chooseAnswer(index) {
			if (answered) return;
			answered = true;
			const question = activeQuiz.quiz[questionIndex];
			const buttons = [...document.querySelectorAll(".answer")];
			buttons.forEach((button, answerIndex) => {
				button.disabled = true;
				if (answerIndex === question.correct) button.classList.add("correct");
				else if (answerIndex === index) button.classList.add("incorrect");
			});
			if (index === question.correct) score++;
			document.getElementById("scoreText").textContent = `${score} correct`;
			document.getElementById("feedback").textContent = index === question.correct ? "Exactly right. Nice one!" : `Not quite. The answer is ${question.a[question.correct]}.`;
			const next = document.getElementById("nextQuestion");
			next.innerHTML = questionIndex === activeQuiz.quiz.length - 1 ? "See your score →" : "Next question →";
			next.hidden = false;
			next.focus();
		}

		function finishQuiz() {
			const total = activeQuiz.quiz.length;
			const percentage = Math.round(score / total * 100);
			quizHistory.push({ quizId: activeQuiz.id, score, total, completedAt: new Date().toISOString() });
			if (storage) {
				try {
					storage.setItem(historyStorageKey, JSON.stringify(quizHistory));
					historyStorageError = "";
				} catch (error) {
					historyStorageError = "Your score couldn't be saved between visits, but it will remain visible for this visit.";
				}
			}
			renderHistory();
			document.getElementById("questionView").hidden = true;
			document.getElementById("scoreView").hidden = false;
			document.getElementById("finalScore").textContent = `${score}/${total}`;
			document.getElementById("scoreHeading").textContent = percentage === 100 ? "A perfect little run!" : percentage >= 60 ? "Look at that curious mind." : "Now you know a little more.";
			document.getElementById("scoreMessage").textContent = `${percentage}% correct. Fancy another quiz?`;
			document.getElementById("progressFill").style.width = "100%";
			document.getElementById("finishQuiz").focus();
		}

		function scrollToTarget(element) {
			if (element && typeof element.scrollIntoView === "function") {
				element.scrollIntoView({ behavior: "smooth", block: "start" });
			}
		}

		categoryList.addEventListener("click", (event) => {
			const button = event.target.closest("[data-category]");
			if (!button) return;
			state.category = button.dataset.category;
			state.savedOnly = false;
			state.visibleCount = initialVisibleCount;
			render();
		});

		document.getElementById("difficultyChips").addEventListener("click", (event) => {
			const button = event.target.closest("[data-difficulty]");
			if (!button) return;
			state.difficulty = button.dataset.difficulty;
			state.visibleCount = initialVisibleCount;
			document.querySelectorAll(".chip").forEach((chip) => chip.classList.toggle("active", chip === button));
			renderQuizzes();
		});

		quizGrid.addEventListener("click", (event) => {
			const saveButton = event.target.closest("[data-save]");
			if (saveButton) {
				const id = saveButton.dataset.save;
				if (savedIds.has(id)) savedIds.delete(id); else savedIds.add(id);
				renderQuizzes();
				return;
			}
			const playButton = event.target.closest("[data-quiz]");
			if (playButton) openQuiz(playButton.dataset.quiz);
		});

		document.querySelector(".feature").addEventListener("click", (event) => {
			const button = event.target.closest("[data-quiz]");
			if (button) openQuiz(button.dataset.quiz);
		});

		searchInput.addEventListener("input", () => { state.query = searchInput.value.trim(); state.visibleCount = initialVisibleCount; renderQuizzes(); });
		document.getElementById("sortSelect").addEventListener("change", (event) => { state.sort = event.target.value; state.visibleCount = initialVisibleCount; renderQuizzes(); });
		document.getElementById("savedLink").addEventListener("click", (event) => {
			event.preventDefault();
			document.getElementById("discover").hidden = false;
			document.getElementById("historyPage").hidden = true;
			state.savedOnly = true;
			state.category = "All quizzes";
			state.visibleCount = initialVisibleCount;
			showView("discover");
			render();
			scrollToTarget(document.getElementById("quizGrid"));
		});
		document.getElementById("discoverLink").addEventListener("click", (event) => {
			event.preventDefault();
			state.savedOnly = false;
			state.category = "All quizzes";
			state.visibleCount = initialVisibleCount;
			showView("discover");
			render();
			scrollToTarget(document.getElementById("feature"));
		});
		document.getElementById("historyLink").addEventListener("click", (event) => {
			event.preventDefault();
			showView("history");
			renderHistory();
			scrollToTarget(document.getElementById("historyPage"));
		});
		document.getElementById("historyList").addEventListener("click", (event) => {
			const replayButton = event.target.closest("[data-replay]");
			if (replayButton) openQuiz(replayButton.dataset.replay);
		});
		document.getElementById("loadMoreButton").addEventListener("click", () => {
			const results = filteredQuizzes();
			state.visibleCount = Math.min(state.visibleCount + 24, results.length);
			renderQuizzes();
		});

		document.getElementById("surpriseButton").addEventListener("click", () => {
			const options = filteredQuizzes();
			const pool = options.length ? options : quizzes;
			openQuiz(pool[Math.floor(Math.random() * pool.length)].id);
		});
		document.getElementById("closeModal").addEventListener("click", closeQuiz);
		document.getElementById("finishQuiz").addEventListener("click", closeQuiz);
		document.getElementById("nextQuestion").addEventListener("click", () => {
			if (questionIndex === activeQuiz.quiz.length - 1) finishQuiz();
			else { questionIndex++; renderQuestion(); }
		});
		document.getElementById("answerList").addEventListener("click", (event) => {
			const button = event.target.closest("[data-answer]");
			if (button) chooseAnswer(Number(button.dataset.answer));
		});
		modal.addEventListener("click", (event) => { if (event.target === modal) closeQuiz(); });
		document.addEventListener("keydown", (event) => { if (event.key === "Escape" && !modal.hidden) closeQuiz(); });

		function closeQuiz() {
			modal.hidden = true;
			document.body.style.overflow = "";
		}

		render();
	</script>
</body>
</html>
